#!/bin/bash

G='\033[0;32m'; R='\033[0;31m'; N='\033[0m'

pause(){ read -p "Enter bosing..."; }

valid_ip(){
    [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    IFS=. read -r a b c d <<< "$1"
    for n in $a $b $c $d; do ((n<=255)) || return 1; done
}

valid_port(){
    [[ $1 =~ ^[0-9]+$ ]] && (( $1>=1 && $1<=65535 ))
}

# 1. PORT SCANNER
port_scanner(){
    clear; echo "===== PORT SCANNER ====="
    read -p "Target IP: " ip

    valid_ip "$ip" || {
        echo -e "${R}Noto'g'ri IP!${N}"; pause; return
    }

    read -p "Portlar (22,80 yoki 20-25): " ports
    start=$(date +%s); open=()

    IFS=',' read -ra list <<< "$ports"

    for x in "${list[@]}"; do
        if [[ $x == *-* ]]; then
            a=${x%-*}; b=${x#*-}
            valid_port "$a" && valid_port "$b" && ((a<=b)) || {
                echo -e "${R}Noto'g'ri port range!${N}"; pause; return
            }
            for ((p=a;p<=b;p++)); do
                timeout 1 bash -c "echo >/dev/tcp/$ip/$p" 2>/dev/null &&
                open+=("$p")
            done
        else
            valid_port "$x" || {
                echo -e "${R}Noto'g'ri port!${N}"; pause; return
            }
            timeout 1 bash -c "echo >/dev/tcp/$ip/$x" 2>/dev/null &&
            open+=("$x")
        fi
    done

    echo "===== OPEN PORTS ====="
    if ((${#open[@]})); then
        printf '%s\n' "${open[@]}" | sort -nu
    else
        echo "Ochiq port topilmadi."
    fi
    echo "Scan vaqti: $(($(date +%s)-start)) soniya"
    pause
}

# 2. PING SWEEPER
ping_sweeper(){
    clear; echo "===== PING SWEEPER ====="
    read -p "Network (10.0.2): " net

    [[ $net =~ ^([0-9]{1,3}\.){2}[0-9]{1,3}$ ]] || {
        echo -e "${R}Noto'g'ri network!${N}"; pause; return
    }

    IFS=. read -r a b c <<< "$net"
    ((a<=255 && b<=255 && c<=255)) || {
        echo -e "${R}Noto'g'ri network!${N}"; pause; return
    }

    > alive_hosts.txt
    echo "Tarmoq tekshirilmoqda..."

    for i in {1..255}; do
        (ping -c 1 -W 1 "$net.$i" >/dev/null 2>&1 &&
        echo "$net.$i" >> alive_hosts.txt) &
    done
    wait

    sort -V -o alive_hosts.txt alive_hosts.txt

    echo "===== ALIVE HOSTS ====="
    cat alive_hosts.txt
    echo "Natija: alive_hosts.txt"
    pause
}

# 3. USER AUDITOR
user_auditor(){
    clear; echo "===== LINUX USER AUDITOR ====="
    report="audit_report.txt"

    {
        echo "===== LINUX USER AUDIT ====="
        echo "Sana: $(date)"
        echo

        echo "NORMAL USERS (UID >= 1000)"
        awk -F: '$3>=1000 && $3<65534 {print $1,"| UID:",$3}' /etc/passwd

        echo
        echo "SUDO USERS"
        getent group sudo 2>/dev/null || echo "sudo guruhi topilmadi"

        echo
        echo "WHEEL USERS"
        getent group wheel 2>/dev/null || echo "wheel guruhi topilmadi"

        echo
        echo "PASSWORDLESS USERS"
        if [ -r /etc/shadow ]; then
            awk -F: '$2=="" {print $1}' /etc/shadow
        else
            echo "sudo kerak"
        fi

        echo
        echo "UID 0 ACCOUNTS"
        awk -F: '$3==0 {print $1}' /etc/passwd

    } | tee "$report"

    echo "Report: $report"
    pause
}

# 4. SUBDOMAIN FINDER
subdomain_finder(){
    clear; echo "===== SUBDOMAIN FINDER ====="

    command -v host >/dev/null || {
        echo "host topilmadi. sudo apt install dnsutils"
        pause; return
    }

    read -p "Domain: " domain
    read -p "Wordlist: " wordlist

    [[ $domain =~ ^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$ ]] || {
        echo -e "${R}Noto'g'ri domain!${N}"; pause; return
    }

    [ -f "$wordlist" ] || {
        echo -e "${R}Wordlist topilmadi!${N}"; pause; return
    }

    while read -r word; do
        [ -z "$word" ] && continue
        sub="$word.$domain"
        ip=$(host "$sub" 2>/dev/null | awk '/has address/{print $NF;exit}')
        [ -n "$ip" ] && echo -e "${G}[FOUND] $sub -> $ip${N}"
    done < "$wordlist"

    echo "Qidiruv tugadi."
    pause
}

# MAIN MENU
while true; do
    clear
    echo "======================"
    echo "     LINUXSEC TOOL"
    echo "======================"
    echo "1. Port Scanner"
    echo "2. Ping Sweeper"
    echo "3. User Auditor"
    echo "4. Subdomain Finder"
    echo "5. Exit"
    echo "======================"

    read -p "Tanlang [1-5]: " c

    case $c in
        1) port_scanner ;;
        2) ping_sweeper ;;
        3) user_auditor ;;
        4) subdomain_finder ;;
        5) exit ;;
        *) echo "Noto'g'ri tanlov!"; sleep 1 ;;
    esac
done
